# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/fantag.db
# PostgreSQL (Phase 2): postgresql://user:password@db:5432/fantag

# ── OCR Provider ──────────────────────────────────────────────────
# "claude" or "openai"
OCR_PROVIDER=claude

# ── Anthropic (Claude Vision) — used when OCR_PROVIDER=claude ─────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenAI (GPT-4o Vision) — used when OCR_PROVIDER=openai ────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Scheduler (CST) ───────────────────────────────────────────────
DAILY_POLL_HOUR=6
DAILY_POLL_MINUTE=0

# ── MLB Stats API (free, no key needed) ───────────────────────────
MLB_STATS_API=https://statsapi.mlb.com/api/v1

# ── ESPN Fantasy Sync ─────────────────────────────────────────────
# Configure these in the FANTAG Settings UI, not here, so cookies stay in the app DB.
# Required fields in UI: League ID, Season, optional Team ID, SWID cookie, espn_s2 cookie.
