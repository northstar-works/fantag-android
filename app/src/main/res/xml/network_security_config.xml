<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Private self-hosted FANTAG repo build.
         Default production target is https://fantag.sidneyshelton.com/.
         Cleartext is still permitted for local/LAN troubleshooting URLs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">sidscri.from-tx.com</domain>
        <domain includeSubdomains="true">sidneyshelton.com</domain>
        <domain includeSubdomains="true">fantag.sidneyshelton.com</domain>
        <domain includeSubdomains="false">192.168.0.4</domain>
        <domain includeSubdomains="false">192.168.0.73</domain>
        <domain includeSubdomains="false">192.168.0.110</domain>
    </domain-config>
</network-security-config>
