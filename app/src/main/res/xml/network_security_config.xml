<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP to the FANTAG DDNS domain and local IPs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">sidscri.from-tx.com</domain>
        <!-- Local network fallback - add your server IP here if needed -->
        <!-- <domain includeSubdomains="false">192.168.1.100</domain> -->
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
